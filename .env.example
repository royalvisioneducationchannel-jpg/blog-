# Copy to .env and fill in. Never commit .env.

PORT=3000
# Public URL of this app (used for the Facebook Login redirect). Must match the
# "Valid OAuth Redirect URIs" entry in your Meta app: ${APP_URL}/auth/facebook/callback
APP_URL=http://localhost:3000
NODE_ENV=development

# Random long strings, e.g. `openssl rand -hex 32`
SESSION_SECRET=
ENCRYPTION_KEY=

# Meta (Facebook) app from https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Business apps: Facebook Login for Business -> Configurations -> Configuration ID
# (leave empty to use classic Facebook Login with scopes)
META_LOGIN_CONFIG_ID=

# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# Daily report schedule (cron syntax) and time zone
REPORT_CRON=0 9 * * *
REPORT_TZ=Asia/Karachi

# Where the JSON database and uploaded images are stored
DATA_DIR=./data
